// This file is managed by Ansible. Manual changes will be overwritten.
// Alloy v{{ alloy_version }} — log shipping to Loki at {{ alloy_loki_url }}

{% if alloy_log_source == "docker" %}
// ---------- Source: Docker container logs ----------

discovery.docker "containers" {
  host             = "{{ alloy_docker_host }}"
  refresh_interval = "30s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "containers" {
  host       = "{{ alloy_docker_host }}"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.default.receiver]
}

{% else %}
// ---------- Source: Files ----------

local.file_match "files" {
  path_targets = [
{% for path in alloy_file_paths %}
    {__path__ = "{{ path }}"},
{% endfor %}
  ]
}

loki.source.file "files" {
  targets    = local.file_match.files.targets
  forward_to = [loki.process.default.receiver]
}

{% endif %}
// ---------- Processing ----------

loki.process "default" {
  forward_to = [loki.write.default.receiver]
}

// ---------- Sink: central Loki ----------

loki.write "default" {
  endpoint {
    url = "{{ alloy_loki_url }}"
  }

  external_labels = {
{% for k, v in alloy_external_labels.items() %}
    {{ k }} = "{{ v }}",
{% endfor %}
  }
}
